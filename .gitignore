# ===== Office 临时文件 =====
# Excel/Word 打开时生成的锁文件（~$ 开头）
~$*
*.tmp

# ===== Windows 系统垃圾 =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp

# ===== Python（如后续加入采集脚本）=====
__pycache__/
*.py[cod]
.venv/
venv/
.env

# ===== Node / Next.js =====
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*

# ===== Prisma / 本地数据库 =====
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite-journal

# ===== 定时采集调度器状态文件（lib/daily-crawler.ts 运行时写入）=====
crawler/.crawler_state.json

# ===== 核验失效计数文件（verify_nationwide.py 存活核验容错计数）=====
crawler/.verify_fails.json

# ===== Trae / IDE 分享临时包 =====
.trae-html-share-packages/
