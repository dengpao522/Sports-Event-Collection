# 复制为 .env 后按需修改。.env 不会被提交。

# 本地开发数据库（SQLite 文件，位于 prisma/dev.db）
DATABASE_URL="file:./dev.db"

# 邮件发送：开发期用 mock（仅控制台输出，不真实发信）；正式期改为 resend / smtp
MAIL_PROVIDER="mock"
MAIL_FROM="全民运动 <no-reply@example.com>"

# 站点地址（订阅确认/退订链接用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 运营后台（/admin）登录密码，务必改成自己的强密码
ADMIN_PASSWORD="change-me"
